{
  "name": "factory",
  "version": "0.0.1",
  "private": true,
  "description": "Generyczna fabryka oprogramowania oparta na Claude Code",
  "type": "module",
  "exports": {
    "./app": "./scripts/app/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"scripts/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.app.json",
    "validate": "node scripts/config/cli.ts",
    "agents": "node scripts/agents/build.ts",
    "skill:zip": "mkdir -p dist && rm -f dist/spec-writer.zip && cd skills && zip -qr ../dist/spec-writer.zip spec-writer"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
